! expanse.inf — empty expandable seed. Walk any direction and the engine grows
! a room there at runtime (via the expanse.h pool). CC0.
Constant Story "EXPANSE";
Constant Headline "^An empty, growable world.^";
Include "Parser";
Include "VerbLib";

[ Initialise;
   location = Origin;
   "^You stand at the origin of an empty world. Walk in any direction.^";
];

! The seed room must declare all six exit slots (= 0) so new rooms can link into it.
Object Origin "Origin"
  with description "A featureless origin point. Paths lead off to the north, south, east, and west, and a stair heads down.",
       n_to 0, s_to 0, e_to 0, w_to 0, u_to 0, d_to 0,
  has light;

Include "expanse.h";
Include "Grammar";
